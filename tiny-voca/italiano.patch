+        "ð": ("d",), "ʒ": ("dʒ",), "ɱ": ("m",), "ç": ("ʃ",), "ɣ": ("ɡ",), "β": ("v",),
+        "eɪ": ("e", "i"), "aɪ": ("a", "i"), "aʊ": ("a", "u"), "oʊ": ("o", "u"), "ɔɪ": ("ɔ", "i"),
