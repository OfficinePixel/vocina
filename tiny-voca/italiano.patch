From 557b474ce301c710a4743f88d18fa4693595ea92 Mon Sep 17 00:00:00 2001
From: bancollm <pixel@officinepixel.com>
Date: Wed, 18 Nov 2026 10:32:19 +0100
Subject: [PATCH 2/3] Italiano: frontend own con il G2P di bancollm (g2p_it),
 voci da TINY_VOCA_VOCI

---
 src/tiny_voca/config.py |  4 +++-
 src/tiny_voca/text.py   | 18 ++++++++++++++++++
 2 files changed, 21 insertions(+), 1 deletion(-)

diff --git a/src/tiny_voca/config.py b/src/tiny_voca/config.py
index 2699085..94986ba 100644
--- a/src/tiny_voca/config.py
+++ b/src/tiny_voca/config.py
@@ -1,3 +1,4 @@
+import os
 from dataclasses import asdict, dataclass
 import hashlib
 import json
@@ -21,7 +22,8 @@ class Config:
     n_mels: int = 80
     f0_min: float = 50.0
     f0_max: float = 600.0
-    speakers: tuple[str, ...] = ("F2", "M2") if LANGUAGE == "en" else ("I1",)
+    # Italiano: TINY_VOCA_VOCI="I1,I2" per il modello a due voci (il pilota ne ha una).
+    speakers: tuple[str, ...] = ("F2", "M2") if LANGUAGE == "en" else tuple(os.environ.get("TINY_VOCA_VOCI", "I1").split(","))
     # Phoneme tokens from tiny_voca.text.SYMBOLS (front-end version 3).
     vocab_size: int = len(_SYMBOLS)  # 76 in inglese
     # Text encoder and frame-level transformer.
diff --git a/src/tiny_voca/text.py b/src/tiny_voca/text.py
index 6a776e1..b05d5c4 100644
--- a/src/tiny_voca/text.py
+++ b/src/tiny_voca/text.py
@@ -132,6 +132,17 @@ def set_frontend(name):
     _frontend = name
 
 
+def _g2p_it():
+    """Il G2P italiano di bancollm (g2p_it.py, solo libreria standard), al posto di dizione per l'italiano."""
+    try:
+        import g2p_it
+    except ImportError as error:
+        raise RuntimeError('the "own" Italian front end needs g2p_it on the path (bancollm/voce/g2p_it)') from error
+    if tuple(g2p_it.SYMBOLS) != SYMBOLS:
+        raise RuntimeError("g2p_it's symbol inventory differs from this model's")
+    return g2p_it
+
+
 def _dizione():
     try:
         import dizione
@@ -143,6 +154,9 @@ def _dizione():
 
 
 def frontend_identity():
+    if _frontend == "own" and LANGUAGE == "it":
+        g2p = _g2p_it()
+        return {"frontend_version": g2p.VERSIONE, "phonemizer": "g2p_it", "fingerprint": g2p.impronta(), "symbols": list(SYMBOLS)}
     if _frontend == "own":
         phonemizer = _dizione()
         return {"frontend_version": phonemizer.VERSION, "phonemizer": "dizione", "symbols": list(SYMBOLS)}
@@ -153,6 +167,8 @@ def frontend_identity():
 def frontend_runtime():
     """What an annotation run records about the exact program behind its
     tokens: the eSpeak version, or the fingerprint of the phonemizer build."""
+    if _frontend == "own" and LANGUAGE == "it":
+        return {"phonemizer": _g2p_it().impronta()}
     if _frontend == "own":
         return {"phonemizer": _dizione().identity()["fingerprint"]}
     return {"espeak_version": espeak_version()}
@@ -295,6 +311,8 @@ def tokenize(pieces):
 def phonemize(text):
     if not isinstance(text, str) or not text.strip():
         raise ValueError("text must not be empty")
+    if _frontend == "own" and LANGUAGE == "it":
+        return tokenize(_g2p_it().pezzi(text))
     if _frontend == "own":
         return tokenize(_dizione().pieces(text))
     pieces = []
-- 
2.56.0


From 0118bfa4b9c68ff1880d5b2e5fae0e0ec30e1358 Mon Sep 17 00:00:00 2001
From: bancollm <pixel@officinepixel.com>
Date: Wed, 18 Nov 2026 15:11:54 +0100
Subject: [PATCH 3/3] Italiano: 8 simboli riservati in coda al vocabolario
 (57), per suoni non verbali da insegnare con un affinamento

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/tiny_voca/text.py | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/tiny_voca/text.py b/src/tiny_voca/text.py
index b05d5c4..b256798 100644
--- a/src/tiny_voca/text.py
+++ b/src/tiny_voca/text.py
@@ -88,8 +88,12 @@ else:
     }
     ABBREVIATIONS = {"mr", "mrs", "ms", "dr", "prof", "st", "jr", "sr", "vs", "etc"}
 PHONES = CONSONANTS + VOWELS
+# Riservati in coda (solo italiano, dal 2026-11-18): mai prodotti dal frontend, per insegnare più avanti
+# suoni non verbali con un affinamento, senza cambiare vocab_size. Non sono fonemi: come la punteggiatura,
+# il modello ne decide presenza e durata. Il pilota (49 simboli) non li ha.
+RESERVED = tuple(f"<riservato{i}>" for i in range(1, 9)) if LANGUAGE == "it" else ()
 # Append-only: changing the order or removing a symbol invalidates checkpoints.
-SYMBOLS = SPECIALS + PUNCTUATION + PHONES
+SYMBOLS = SPECIALS + PUNCTUATION + PHONES + RESERVED
 SYMBOL_TO_ID = {symbol: index for index, symbol in enumerate(SYMBOLS)}
 PHONE_SET = frozenset(PHONES)
 PHONE_IDS = frozenset(SYMBOL_TO_ID[p] for p in PHONES) | {SYMBOL_TO_ID[UNK]}
-- 
2.56.0

